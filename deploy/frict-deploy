#!/bin/bash
# Deploys one digest of the frict-server image on the box. Runs as root through
# sudo from the forced command of GitHub's deploy key, so SSH_ORIGINAL_COMMAND is
# the client's input: one sha256 digest and nothing else. docs/deploy.md.
#
# Output reaches a public Actions log; frict-server's own logs stay in logs/.
set -euo pipefail
export LC_ALL=C PATH=/usr/local/bin:/usr/bin:/bin
umask 077

image=ghcr.io/frict-auth/frict-server
dir=/srv/frict
url=http://127.0.0.1:8081/healthz
health_wait=20

digest=${SSH_ORIGINAL_COMMAND-}
if [[ ! $digest =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "REFUSED: want sha256:<64 lowercase hex digits> and nothing else. Nothing changed." >&2
  exit 2
fi

cd "$dir"
mkdir -p backups logs
exec 9>.lock
if ! flock -n 9; then
  echo "REFUSED: another deploy is running. Nothing changed." >&2
  exit 1
fi

# A lost SSH connection must not stop a deploy halfway: output goes to a file
# and is copied to the client at the end.
stamp=$(date -u +%Y%m%dT%H%M%SZ)-${digest:7:12}
log=logs/$stamp.log
exec 3>&1 >"$log" 2>&1
trap '' HUP PIPE
finish() {
  local code=$?
  cat "$log" >&3
  exit "$code"
}
trap finish EXIT

state() { if [[ -f .env ]]; then sed -n "s/^$1=//p" .env; fi; }
current=$(state FRICT_DIGEST)
current_commit=$(state FRICT_MAIN_COMMIT)

# dc DIGEST ARGS...: docker compose with the image at DIGEST.
dc() { FRICT_DIGEST=$1 docker compose --ansi never --progress plain "${@:2}"; }

container() { dc "$1" ps --all --quiet frict-server; }

# runs DIGEST: the container is running exactly that image.
runs() {
  local id image_id digests
  id=$(container "$1") && [[ -n $id ]] || return 1
  [[ $(docker inspect --format '{{.State.Running}}' "$id") == true ]] || return 1
  image_id=$(docker inspect --format '{{.Image}}' "$id") || return 1
  digests=$(docker image inspect --format '{{join .RepoDigests "\n"}}' "$image_id") || return 1
  [[ $'\n'$digests$'\n' == *$'\n'"$image@$1"$'\n'* ]]
}

healthy() { curl -fs --max-time 5 --noproxy '*' -o /dev/null "$url"; }

# comes_up DIGEST: DIGEST is running and healthy within health_wait seconds.
# A freshly created container that restarts has crashed.
comes_up() {
  local id deadline=$((SECONDS + health_wait))
  id=$(container "$1") && [[ -n $id ]] || return 1
  until healthy; do
    if [[ $(docker inspect --format '{{.RestartCount}}' "$id") != 0 ]]; then
      echo "frict-server exited after starting"
      return 1
    fi
    if ((SECONDS >= deadline)); then
      echo "/healthz did not answer 200 within ${health_wait}s"
      return 1
    fi
    sleep 1
  done
  runs "$1" || { echo "the running container is not $image@$1"; return 1; }
}

# save_logs DIGEST: keeps the container's own log; compose removes it with the
# container.
save_logs() {
  local id
  id=$(container "$1") && [[ -n $id ]] && docker logs "$id" >"logs/$stamp-server-${1:7:12}.log" 2>&1
}

# go_back never returns.
go_back() {
  echo "DEPLOY FAILED: $image@$digest"
  save_logs "$digest" || echo "could not save frict-server's log"
  echo "frict-server's log is in $dir/logs on the box."
  if [[ -z $current || $current == "$digest" ]]; then
    dc "$digest" stop frict-server || echo "could not stop frict-server"
    echo "SERVER IS DOWN: there is no previous version to go back to."
    exit 1
  fi
  echo "Going back to $current"
  if dc "$current" up --detach --force-recreate --pull never frict-server && comes_up "$current"; then
    echo "WENT BACK: $image@$current is running and healthy."
    exit 1
  fi
  save_logs "$current" || echo "could not save frict-server's log"
  echo "SERVER IS DOWN: going back to $current failed too."
  if grep -qs "newer than this binary" "logs/$stamp-server-${current:7:12}.log"; then
    echo "The new version migrated the database and the previous one refuses the newer schema."
    echo "Restore $dir/backups/$stamp.tar (docs/deploy.md, Restore)."
  fi
  exit 1
}

if ! docker pull --quiet "$image@$digest"; then
  echo "REFUSED: cannot pull $image@$digest. Nothing changed."
  exit 1
fi
commit=$(docker image inspect --format '{{index .Config.Labels "app.frict.main-commit"}}' "$image@$digest")
if [[ ! $commit =~ ^[1-9][0-9]{0,8}$ ]]; then
  echo "REFUSED: the image has no app.frict.main-commit label. Nothing changed."
  exit 1
fi
if [[ -n $current ]] && ((commit < current_commit)); then
  echo "REFUSED: built from commit $commit on main, older than the deployed $current_commit. To go back, revert on main. Nothing changed."
  exit 1
fi

if ! dc "$digest" config --quiet; then
  echo "REFUSED: $dir/compose.yaml or what it names is broken. Nothing changed."
  exit 1
fi

# Nothing has the database open between stop and start, so the copy is
# consistent.
replace() {
  echo "Deploying $image@$digest (commit $commit on main)"
  dc "$digest" stop frict-server &&
    dc "$digest" create --force-recreate --pull never frict-server &&
    docker cp "$(container "$digest"):/data" - >"backups/$stamp.tar" &&
    echo "Backed up /data to $dir/backups/$stamp.tar" &&
    dc "$digest" start frict-server &&
    comes_up "$digest"
}
previous=$current
if [[ $current == "$digest" ]]; then
  previous=$(state FRICT_PREVIOUS_DIGEST)
fi

if runs "$digest" && healthy; then
  echo "$image@$digest is already running and healthy. Not restarted."
else
  replace || go_back
fi

if ! printf '%s\n' "FRICT_DIGEST=$digest" "FRICT_MAIN_COMMIT=$commit" "FRICT_PREVIOUS_DIGEST=$previous" >.env.new || ! mv .env.new .env; then
  echo "DEPLOY FAILED: $image@$digest is running and healthy, but $dir/.env doesn't record it. Fix that and deploy again."
  exit 1
fi
echo "OK: $image@$digest is running and healthy. Previous: ${previous:-none}"
